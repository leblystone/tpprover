rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only read/write their own encrypted data
    match /userdata/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Invite codes - read for validation, write for initialization
    match /inviteCodes/{codeId} {
      allow read: if true; // Anyone can read for validation
      allow write: if true; // Temporary: allow writes for setup
    }
    
    // Email whitelist - read for validation, write for initialization
    match /config/emailWhitelist {
      allow read: if true; // Anyone can read for validation
      allow write: if true; // Temporary: allow writes for setup
    }
    
    // Announcements - read for all users, write for initialization
    match /announcements/{announcementId} {
      allow read: if true; // All users can read announcements
      allow write: if true; // Temporary: allow writes for setup
    }
    
    // Analytics - allow writes for initialization
    match /analytics/{document} {
      allow read, write: if true; // Temporary: allow for setup
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
