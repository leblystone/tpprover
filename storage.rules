rules_version = '2';

// Firebase Storage Security Rules for The Pep Planner
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Helper function to validate image files
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 // Max 5MB
          && request.resource.contentType.matches('image/.*');
    }
    
    // Stockpile documentation images
    // Path: stockpile-docs/{userId}/{imageId}
    match /stockpile-docs/{userId}/{imageId} {
      // Allow read if authenticated (users can view their own images)
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Allow write (create/update) if authenticated, owns the path, and file is valid
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
      
      // Allow delete if authenticated and owns the path
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Orders documentation images
    // Path: orders-docs/{userId}/{imageId}
    match /orders-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Protocol documentation images
    // Path: protocol-docs/{userId}/{imageId}
    match /protocol-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Support ticket images
    // Path: support-docs/{userId}/{imageId}
    match /support-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Default: Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

