rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'lebrockmaldonado@gmail.com' ||
        request.auth.token.email == 'contact@thepepplanner.com' ||
        request.auth.token.email == 'thepepplanner@gmail.com'
      );
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /shop-products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /stockpile-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if (isAuthenticated() && isOwner(userId) && isValidImage()) || isAdmin();
      allow delete: if (isAuthenticated() && isOwner(userId)) || isAdmin();
    }

    match /orders-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if (isAuthenticated() && isOwner(userId) && isValidImage()) || isAdmin();
      allow delete: if (isAuthenticated() && isOwner(userId)) || isAdmin();
    }

    match /protocol-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if (isAuthenticated() && isOwner(userId) && isValidImage()) || isAdmin();
      allow delete: if (isAuthenticated() && isOwner(userId)) || isAdmin();
    }

    match /support-docs/{userId}/{imageId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if (isAuthenticated() && isOwner(userId) && isValidImage()) || isAdmin();
      allow delete: if (isAuthenticated() && isOwner(userId)) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
